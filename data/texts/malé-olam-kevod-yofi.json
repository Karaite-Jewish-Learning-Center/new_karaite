{
  "id": "malé-olam-kevod-yofi",
  "title_en": "Malé ‘Olam Kevod Yofi",
  "title_he": "",
  "category": "Liturgy",
  "subcategory": "",
  "content": [
    {
      "hebrew": "מָ֒לֵא עוֹלָם כְּבוֹד יוֹפִי",
      "transliteration": "Malé ‘olam kevod yofi",
      "english": "Beautiful Glory fills the world."
    },
    {
      "hebrew": "גְּדֻלַּת אֵל יְזַמֵּר פִּי",
      "transliteration": "Gedullat el yezammer pi",
      "english": "My mouth sings of God’s greatness."
    },
    {
      "hebrew": "יֹצְאֵי שַׁבָּת עֹרְכִים תְּפִ-",
      "transliteration": "Yotse’é shabbat ‘orechim tefi-",
      "english": "Those parting from the Sabbath pray"
    },
    {
      "hebrew": "לָּה גַּם בֹּקֶר וְגַם עֶרֶב:",
      "transliteration": "La gam boḳer veḡam ‘erev.",
      "english": "in the morning and in the evening."
    },
    {
      "hebrew": "רִ֒אשׁוֹן שֹׁפְכִים תְּפִלָּתָם",
      "transliteration": "Rishon shofechim tefillatam",
      "english": "First, they pour out their prayer:"
    },
    {
      "hebrew": "לְאֵל עֶלְיוֹן עֲתִירָתָם",
      "transliteration": "Le’el ‘elyon ‘atiratam",
      "english": "their plea to God Most High."
    },
    {
      "hebrew": "הוּא יְקַבֵּל תְּחִנָּתָם",
      "transliteration": "Hu yeḳabbel teḥinnatam",
      "english": "He receives their petition"
    },
    {
      "hebrew": "לְמִן בֹּקֶר וְגַם עֶרֶב:",
      "transliteration": "Lemin boḳer veḡam ‘erev.",
      "english": "from morning until evening."
    },
    {
      "hebrew": "דִּ֒בֵּר יְהֹוָה אֲלֵיהֶם",
      "transliteration": "Dibber adonai alehem",
      "english": "Adonai spoke to them"
    },
    {
      "hebrew": "בְּיַד משֶׁה אֲדֹנֵיהֶם",
      "transliteration": "Beyad moshé adonehem",
      "english": "through Moses, their master:"
    },
    {
      "hebrew": "לְהַבְדִּיל לְבֵין קָדְשֵׁיהֶם",
      "transliteration": "Lehavdil leven ḳodshehem",
      "english": "“Distinguish between their holiness"
    },
    {
      "hebrew": "לְבֵין הַחֹל הוּא בָּעֶרֶב:",
      "transliteration": "Leven haḥol hu ba‘erev.",
      "english": "and the profane in the evening.”"
    },
    {
      "hebrew": "כּ֒וֹס יְשׁוּעוֹת בְּשֵׁם אֶשָּׂא",
      "transliteration": "Kos yeshu‘ot beshem essa",
      "english": "I raise the cup of deliverance in [His] Name."
    },
    {
      "hebrew": "נָא יְהֹוָה הוֹשִׁיעָה שָׂא",
      "transliteration": "Na adonai hoshi‘a sa",
      "english": "Please, Adonai, deliver me, raise [Your eyes],"
    },
    {
      "hebrew": "וְהַצְלִיחָה ראֹשׁ אֹיְבַי שָׂא",
      "transliteration": "Vehatsliḥa rosh oyevai sa",
      "english": "Let me succeed! Lift off the heads of my enemies!"
    },
    {
      "hebrew": "מַהֵר נָטוּ צִלְלֵי עֶרֶב:",
      "transliteration": "Maher natu tsilelé ‘erev.",
      "english": "Hasten, for the shadows of evening are now long."
    },
    {
      "hebrew": "יַ֒יִן הַטּוֹב יַצְהִיל פָּנִים",
      "transliteration": "Yayin hattov yats-hil panim",
      "english": "Good wine makes faces shine"
    },
    {
      "hebrew": "יְשַֹמַּח גַּם לֵב מִיגוֹנִים",
      "transliteration": "Yesammaḥ gam lev miḡonim",
      "english": "and also cheers a melancholy heart."
    },
    {
      "hebrew": "לִכְבוֹד שַׁבָּת עָבַר, בָּנִים",
      "transliteration": "Lichvod shabbat ‘avar banim",
      "english": "In honor of the Sabbath, now parting, the children"
    },
    {
      "hebrew": "מַבְדִּילִים בּוֹ הֵם בָּעֶרֶב:",
      "transliteration": "Mavdilim bo hem ba‘erev.",
      "english": "distinguish it [from the profane] in the evening."
    },
    {
      "hebrew": "חֲ֒קֹר נַפְשִׁי וְגַם תֵּדַע",
      "transliteration": "Ḥaḳor nafshi veḡam teda‘",
      "english": "Examine my soul and you will know"
    },
    {
      "hebrew": "רֵיחַ בֹּשֶׂם הוּא בָּעֵדָה",
      "transliteration": "Re’aḥ bosem hu ba‘eda",
      "english": "the fragrant balsam in the congregation!"
    },
    {
      "hebrew": "סִבָּתוֹ מְאֹד חֲמוּדָה",
      "transliteration": "Sibbato me’od ḥamuda",
      "english": "Its cause is very dear:"
    },
    {
      "hebrew": "מְנוּחָה חָלְפָה בָּעֶרֶב:",
      "transliteration": "Menuḥa ḥalefa ba‘erev.",
      "english": "The [Day of] Rest has passed by this evening."
    },
    {
      "hebrew": "זֹ֒עֲמֵינוּ מִתְרַגְּשִׁים",
      "transliteration": "Zo‘amenu mitraggeshim",
      "english": "Our haters are astir"
    },
    {
      "hebrew": "עֵצוֹת רָעוֹת מְאֹד דּוֹרְשִׁים",
      "transliteration": "‘Etsot ra‘ot me’od doreshim",
      "english": "and seek very evil counsel."
    },
    {
      "hebrew": "קַלְקֵל מַחֲשַׁבְתָּם תָּשִׂים",
      "transliteration": "Ḳalḳel maḥashavtam tasim",
      "english": "Frustrate their plans. May You make"
    },
    {
      "hebrew": "עֲלֵיהֶם נָוֶה בָּעֶרֶב:",
      "transliteration": "‘Alehem navé ba‘erev.",
      "english": "their dwellings collapse this evening!"
    },
    {
      "hebrew": "קִ֒נְאָתֵנוּ לֹא תַעֲלֶה",
      "transliteration": "Ḳinatenu lo ta‘alé",
      "english": "Our envy should not come up"
    },
    {
      "hebrew": "עַל לֵב אָדָם אֲשֶׁר עוֹלֶה",
      "transliteration": "‘Al lev adam asher ‘olé",
      "english": "in the heart of any of us, as we come up."
    },
    {
      "hebrew": "וְלֹא קִנְאַת שִׂנְאַת אֵלֶּה",
      "transliteration": "Velo ḳinat sinat ellé",
      "english": "And may envy and hatred of these [enemies]"
    },
    {
      "hebrew": "תַּעֲלֶה עַל לֵב בָּעֶרֶב:",
      "transliteration": "Ta‘alé ‘al lev ba‘erev.",
      "english": "never come to [their] minds, in the evening."
    },
    {
      "hebrew": "כַּכָּתוּב: כּוֹס־יְשׁוּע֥וֹת אֶשָּׂ֑א וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃",
      "transliteration": "Kakkatuv: Kos yeshu‘ot essa uvshem adonai eḳra.",
      "english": "As it is written: I raise the cup of deliverance and invoke the name of Adonai. (Ps. 116:13)"
    }
  ],
