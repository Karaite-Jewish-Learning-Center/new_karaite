  "content": [
    {
      "hebrew": "Atsili ḳum ḳera",
      "transliteration": "אֲצִילִי קוּם קְרָא",
      "english": "O my noble man, stand up and read"
    },
    {
      "hebrew": "Bedat el nora",
      "transliteration": "בְּדָת אֵל נוֹרָא",
      "english": "From the Law of the awesome God;"
    },
    {
      "hebrew": "Vezot hattora",
      "transliteration": "וְזֹאת הַתּוֹרָה",
      "english": "This is the Torah"
    },
    {
      "hebrew": "Asher sam moshē.",
      "transliteration": "אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "That Moses gave."
    },
    {
      "hebrew": "Vezot hattora asher sam moshē.",
      "transliteration": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "This is the Torah that Moses gave."
    },
    {
      "hebrew": "Beḳumo la‘alot",
      "transliteration": "בְּקוּמוֹ לַעֲלוֹת",
      "english": "When he stands up to ascend,"
    },
    {
      "hebrew": "Yash-sheru mesillot",
      "transliteration": "יַשְּׁרוּ מְסִלּוֹת",
      "english": "Make the paths straight [for him]!"
    },
    {
      "hebrew": "Shir hamma‘alot",
      "transliteration": "שִׁיר הַמַּעֲלוֹת",
      "english": "A song of ascents"
    },
    {
      "hebrew": "Yashir moshe.",
      "transliteration": "יָשִׁיר מֹשֶׁה.",
      "english": "Moses shall sing."
    },
    {
      "hebrew": "Vezot hattora asher sam moshē.",
      "transliteration": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "This is the Torah that Moses gave."
    },
    {
      "hebrew": "Ra‘yat shiran",
      "transliteration": "רַעְיַת שִׁירָן",
      "english": "The beloved woman of their song"
    },
    {
      "hebrew": "Ye‘oreru bezimran",
      "transliteration": "יְעוֹרְרוּ בְּזִמְרָן",
      "english": "They awaken with their chanting,"
    },
    {
      "hebrew": "Re’ot ki ḳaran",
      "transliteration": "רְאוֹת כִּי קָרַן",
      "english": "To see the glow"
    },
    {
      "hebrew": "‘Or penē moshē.",
      "transliteration": "עוֹר פְּנֵי מֹשֶׁה.",
      "english": "Of the flesh of Moses’s face."
    },
    {
      "hebrew": "Vezot hattora asher sam moshē.",
      "transliteration": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "This is the Torah that Moses gave."
    },
    {
      "hebrew": "Haflē ḥasdecha",
      "transliteration": "הַפְלֵה חַסְדְּךָ",
      "english": "Show great mercy"
    },
    {
      "hebrew": "Lemalē paḥdecha",
      "transliteration": "לְמָלֵא פַּחְדְּךָ",
      "english": "To the one that is full of awe for you."
    },
    {
      "hebrew": "Ḳera na le‘avdecha",
      "transliteration": "קְרָא נָא לְעַבְדְּךָ",
      "english": "Call now to your servant:"
    },
    {
      "hebrew": "‘Avdi moshē.",
      "transliteration": "עַבְדִּי מֹשֶׁה.",
      "english": "“My servant Moses!”"
    },
    {
      "hebrew": "Vezot hattora asher sam moshē.",
      "transliteration": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "This is the Torah that Moses gave."
    },
    {
      "hebrew": "Mikkol ‘avarav",
      "transliteration": "מִכָּל עֲבָרָיו",
      "english": "From all sides,"
    },
    {
      "hebrew": "Ya‘anu ḥaverav",
      "transliteration": "יַעֲנוּ חֲבֵרָיו",
      "english": "His friends call out:"
    },
    {
      "hebrew": "Hen mibbeḥurav",
      "transliteration": "הֵן מִבְּחֻרָיו",
      "english": "“Indeed, since his youth,"
    },
    {
      "hebrew": "Mesharet moshē.",
      "transliteration": "מְשָׁרֵת מֹשֶׁה.",
      "english": "Moses has been serving [God]!”"
    },
    {
      "hebrew": "Vezot hattora asher sam moshē.",
      "transliteration": "וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה.",
      "english": "This is the Torah that Moses gave."
    }
  ],
