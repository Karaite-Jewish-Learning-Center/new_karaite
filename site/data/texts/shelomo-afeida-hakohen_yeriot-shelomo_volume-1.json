      "english": ""
    },
    {
      "hebrew": "הדורים בעלי שם גם תהילה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "קטנה היא בעינם כגדולה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "שלמים הם בכל מדה ומעלה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "יצו להם לשמרם במסילה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "סתימת קץ לקרב הגאולה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "ויצליחם במלואי כל שאלה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "ויגדל שם כבודם עד למעלה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "יעוגנו ברוב שלום וגילה[7]",
