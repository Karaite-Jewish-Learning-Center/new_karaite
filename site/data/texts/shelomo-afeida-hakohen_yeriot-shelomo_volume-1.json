      "english": "",
      "comments": "[7] שם אגרת מספר רל\"ז."
    },
    {
      "hebrew": "ובאור חק ומצוה המזהרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "ועינם בם כאלו היא עורת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "אשר דתם מלאכתם על פי קר\"ת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "נבוני לב ברוח מתעוררת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "כפי יד אלהים העוזרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "לאור טמון בספרם כסוחרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "מאד ישמח כמשמן וקטרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "ועל ראשו כמו נזר ועטרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "הכי נמצא בספר האדרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "וככרובים אשר על הכפרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "ובשייצי בבינה הגוברת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "בכוחותיו בבעלי המסורת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "אמת עם מי ועומד על משמרת",
      "transliteration": "",
      "english": ":"
    },
    {
      "hebrew": "בקל למצוא מבוקש עת בקרת",
