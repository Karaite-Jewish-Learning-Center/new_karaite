{
  "id": "shelomo-afeida-hakohen_yeriot-shelomo_volume-2",
  "title_en": "Shelomo Afeida HaKohen_Yeriot Shelomo_Volume 2",
  "title_he": "חלק שני",
  "category": "Halakhah",
  "source": "Shelomo Afeida HaKohen_Yeriot Shelomo_Volume 2.xlsx",
  "content": [
    {
      "hebrew": "בביאור יסודי דת הקראות",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור שבעה מיני ההקש",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור אופן פרוש כתבי הקדש",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור קצת חלוקים עיקריים שבינינו ובין בע\"ק",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור דרך הלימוד",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור עיקר גדול ושרש חזק אשר עליו תסובב כל התורה הוא אמונת חידוש הנמצאות",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור המצא עצם אחד רוחני קדוש ונבדל מכל הנמצאים",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור שהתורה מן השמים ושהיא תמימה ונצחית",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור ידיעת והשגחת השם יתברך כמו בעליונים כן בשפלים ובפרטי בני אדם",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור אמונת תחית המתים וביאת המשיח",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "באיסור עבודה זרה ונשיאת שם השם לשוא ולשקר",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "במצות כיבוד הורים והחכמים וההנהגה עם הבריות",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור אבות הנזיקין אשר הוזהרו בדבורי הלוח השני",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בחיוב בנין בית תפלה ולימוד וקנין כלי בית האלהים",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור ענין התפילה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור ענין הציצית",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור ענין השחיטה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור הטומאות הבאות לאדם מבית ומחוץ אשר הזכירה התורה",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור ענין איסורי עריות",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בביאור איסור כלאי בגדים והרכבת מין שלא במינו בבעלי-חיים ובזרעים",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "גבורות אל ונוראותיו למלל.",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בהתמד רב בכל היום וגם ליל.",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "לספר מחזיק אותם וכולל.",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "ומזוהרות ועונש המחלל.",
      "transliteration": "",
      "english": ""
    },
    {
      "hebrew": "בעז יד אל ומסעד כל המחולל.",
      "transliteration": "",
      "english": ""
    }
  ]
}