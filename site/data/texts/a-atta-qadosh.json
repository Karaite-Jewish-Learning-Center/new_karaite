{
  "id": "a-atta-qadosh",
  "title_en": "Atta Qadosh",
  "title_he": "אַתָּה קָדוֹשׁ",
  "category": "Liturgy",
  "subcategory": "Weekly Kedushot",
  "source": "kedushot.xlsx",
  "content": [
    {
      "hebrew": "אַתָּה קָדוֹשׁ, יַעֲרִיצֽוּךָ הֲמוֹנָי;",
      "transliteration": "Atta ḳadosh ya‘aritsucha hamonai",
      "english": "You are holy—my multitudes adulate You.",
      "comments": "",
      "timing": {
        "start": 0,
        "end": 15.85
      }
    },
    {
      "hebrew": "פִּלְאֲךָ יְחַוּוּ עִירִין וְקַדִּישִׁין וְשִׁנְאָנָי,",
      "transliteration": "Pil’acha yeḥavvu ‘irin veḳaddishin veshin’anai,",
      "english": "‘Irin and qaddishin and shin’anim speak of Your wondrous deeds,",
      "comments": "‘Irin and qaddishin and shin’anim. Types of angels.",
      "timing": {
        "start": 15.85,
        "end": 31.35
      }
    },
    {
      "hebrew": "וְכוֹכְבֵי אוֹר וְכָל־צְבָא מְעוֹנָי,",
      "transliteration": "Vechochevé or vechol tseva me‘onai,",
      "english": "And the stars of light, and the whole host of heaven—",
      "comments": "",
      "timing": {
        "start": 31.35,
        "end": 38.18
      }
    },
    {
      "hebrew": "וְיוֹדוּ שָׁמַֽיִם פִּלְאֲךָ יוי.",
      "transliteration": "Veyodu shamayim pil’acha adonai.",
      "english": "And heaven acknowledges Your wondrous deeds, Adonai! (Psalms 89:6)",
      "comments": "",
      "timing": {
        "start": 38.18,
        "end": 43.7
      }
    },
    {
      "hebrew": "הַלֵּל וְהוֹדוֹת אֹפַנִּים חָשִׁים,",
      "transliteration": "Hallel vehodot ofannim ḥashim,",
      "english": "The ofannim hasten [with] praise and acknowledgment,",
      "comments": "Ofannim. A type of angel.",
      "timing": {
        "start": 43.7,
        "end": 56.42
      }
    },
    {
      "hebrew": "מִשְׁתָּאִים לַחֲזוֹת הוֹד, וְאֵימָה לֹבְשִׁים,",
      "transliteration": "Mishta’im laḥazot hod, ve’ema loveshim,",
      "english": "They yearn to see His splendor, and are robed in dread;",
      "comments": "",
      "timing": {
        "start": 56.42,
        "end": 69.08
      }
    },
    {
      "hebrew": "פַּֽעַם מְמַלְּלִים וּפַֽעַם חָשִׁים,",
      "transliteration": "Pa‘am memallelim ufa‘am ḥashim,",
      "english": "Sometimes they speak, and sometimes they are silent—",
      "comments": "",
      "timing": {
        "start": 69.08,
        "end": 75.83
      }
    },
    {
      "hebrew": "אַף אֱמוּנָתְךָ בִּקְהַל קְדֹשִׁים.",
      "transliteration": "Af emunatekha biḳhal ḳedoshim.",
      "english": "Indeed, Your faith is in the community of the holy. (Psalms 89:6, continued)",
      "comments": "",
      "timing": {
        "start": 75.83,
        "end": 81.86
      }
    },
    {
      "hebrew": "רַבּוּ מַעֲשָׂיו בְּהַצִּיבוֹ בְחָכְמָה כָּל־גְּבוּלִים,",
      "transliteration": "Rabbu ma‘asav, behats-tsivo veḥochma kol gevulim,",
      "english": "Great were His deeds when he set all limits [of the world] with wisdom;",
      "comments": "",
      "timing": {
        "start": 81.86,
        "end": 97.46
      }
    },
    {
      "hebrew": "קֶֽדַח וְקֶֽרַח יָצַר בְּחֹק זְבוּלִים,",
      "transliteration": "Ḳedaḥ veḳeraḥ yatsar beḥoḳ zevulim,",
      "english": "He created fire and ice, according to the laws of heaven,",
      "comments": "",
      "timing": {
        "start": 97.46,
        "end": 110.07
      }
    },
    {
      "hebrew": "וְכָל־מְלָאכוֹת וְתוֹלְדוֹתֵיהֶן מִמֶּֽנּוּ נִפְעָלִים",
      "transliteration": "Vechol melachot vetoledotehen mimmennu nif‘alim,",
      "english": "And all labors, and their derivatives, are issue from Him.",
      "comments": "",
      "timing": {
        "start": 110.07,
        "end": 117.76
      }
    },
    {
      "hebrew": "כִּי מִי בַשַּֽׁחַק יַעֲרֹךְ לַיוי, יִדְמֶה לַיוי בִּבְנֵי אֵלִים.",
      "transliteration": "Ki mi vash-shaḥaḳ ya‘arokh ladonai, yidmé ladonai bivne elim.",
      "english": "For who in heaven could equal Adonai, could resemble Adonai among the sons of gods? (Psalms 89:7)",
      "comments": "",
      "timing": {
        "start": 117.76,
        "end": 124.07
      }
    },
    {
      "hebrew": "נִשְׂגָּב שְׁמוֹ לְבַדּוֹ, דָּגוּל מֵרְבָבָה,",
      "transliteration": "Nisgav shemo levaddo, daḡul merevava,",
      "english": "His name alone is exalted; [He] is prominent among myriads.",
      "comments": "",
      "timing": {
        "start": 124.07,
        "end": 142.01
      }
    },
    {
      "hebrew": "כָּל־מַעֲשָׂיו יְהוֹדֽוּהוּ בְּרֹב חִבָּה,",
      "transliteration": "Kol ma‘asav yehoduhu berov ḥibba,",
      "english": "All His works acknowledge Him, with great love.",
      "comments": "",
      "timing": {
        "start": 142.01,
        "end": 154.51
      }
    },
    {
      "hebrew": "כִּי בְחוֹתָם הִכְלִילָם, בְּאֵין יֹצֵא וְאֵין בָּא,",
      "transliteration": "Ki veḥotam hichlilam, be’en yotsé ve’en ba,",
      "english": "For He encompassed them all within a seal, with none leaving or entering;",
      "comments": "",
      "timing": {
        "start": 154.51,
        "end": 160.98
      }
    },
    {
      "hebrew": "אֵל נַעֲרָץ בְּסוֹד קְדוֹשִׁים רַבָּה.",
      "transliteration": "El na‘arats besod ḳedoshim rabba.",
      "english": "God, declared formidable by the great council of the holy. (Psalms 89:8)",
      "comments": "",
      "timing": {
        "start": 160.98,
        "end": 166.98
      }
    },
    {
      "hebrew": "בָּרוּךְ וּמְבֹרָךְ בְּמַלְאֲכֵי שְׁבִיבָיו,",
      "transliteration": "Baruch umvorach bemal’aché shevivav,",
      "english": "Blessed and declared blessed by His fiery angels,",
      "comments": "",
      "timing": {
        "start": 166.98,
        "end": 182.22
      }
    },
    {
      "hebrew": "נִסְתָּר מֵעֵינֵי כֹל וְנִמְצָא לְאֹהֲבָיו,",
      "transliteration": "Nistar me‘ené chol venimtsa le’ohavav,",
      "english": "He is hidden from the eyes of all, but found by those who love Him.",
      "comments": "",
      "timing": {
        "start": 182.22,
        "end": 194.33
      }
    },
    {
      "hebrew": "מָעוֹז לַדָּל וּמַחְסֶה לַחֲבִיבָיו,",
      "transliteration": "Ma‘oz laddal umaḥsé laḥavivav,",
      "english": "He is a stronghold for the poor, and a refuge for those He loves—",
      "comments": "",
      "timing": {
        "start": 194.33,
        "end": 199.61
      }
    },
    {
      "hebrew": "וְנוֹרָא עַל כָּל־סְבִיבָיו.",
      "transliteration": "Venora ‘al kol sevivav.",
      "english": "And awesome over all that surround Him. (Psalms 89:8, continued)",
      "comments": "",
      "timing": {
        "start": 199.61,
        "end": 205.18
      }
    },
    {
      "hebrew": "נִפְלֵֽאתָ, אֵל, בִּזְרוֹעֲךָ הַנְּטוּיָה,",
      "transliteration": "Nifleta, el, bizro‘acha hannetuya,",
      "english": "You have been wondrous, God, with Your outstretched arm,",
      "comments": "",
      "timing": {
        "start": 205.18,
        "end": 221.25
      }
    },
    {
      "hebrew": "בַּעֲשׂוֹתְךָ נוֹרָאוֹת בְּרֹב תּוּשִׁיָּה.",
      "transliteration": "Ba‘asotecha nora’ot, berov tushiyya.",
      "english": "When You did awesome deeds, with great resourcefulness.",
      "comments": "",
      "timing": {
        "start": 221.25,
        "end": 234.12
      }
    },
    {
      "hebrew": "לָכֵן כֹּל תְּהִלּוֹת מְהַלְּלִים לְךָ דֻמִיָּה:",
      "transliteration": "Lachen kol tehillot mehalelim lecha dumiyya:",
      "english": "Therefore, all praises offered befit You:",
      "comments": "",
      "timing": {
        "start": 234.12,
        "end": 241.0
      }
    },
    {
      "hebrew": "יוי אֱלֹהֵי צְבָאוֹת מִי כָמוֹךָ חֲסִין יָהּ.",
      "transliteration": "Adonai elohe tseva’ot, mi chamocha ḥasin yah.",
      "english": "Adonai, God of Hosts, who is like You, O mighty One, Yah? (Psalms 89:9)",
      "comments": "",
      "timing": {
        "start": 241.0,
        "end": 247.36
      }
    },
    {
      "hebrew": "יָהּ, מִי יַעֲשֶׂה כְמַעֲשֶֽׂיךָ וְכִגְבוּרוֹתֶֽיךָ?",
      "transliteration": "Yah, mi ya‘asé chema‘asecha vechiḡvurotecha?",
      "english": "Yah, who can imitate Your deeds and Your mighty acts?",
      "comments": "",
      "timing": {
        "start": 247.36,
        "end": 264.62
      }
    },
    {
      "hebrew": "וּמִי יַמְצִיא בִּלְתִּי מְצִיאוּתֶֽךָ?",
      "transliteration": "Umi yamtsi bilti metsi’utecha?",
      "english": "Who can create, without Your existence?",
      "comments": "",
      "timing": {
        "start": 264.62,
        "end": 275.08
      }
    },
    {
      "hebrew": "וּמִי יַכְחִישׁ בִּלְתִּי הֶעְדֵּר מִפְעֲלוֹתֶֽיךָ?",
      "transliteration": "Umi yach-ḥish bilti he‘der mifalotecha?",
      "english": "Who can unmake, unless Your works were non-existent?",
      "comments": "",
      "timing": {
        "start": 275.08,
        "end": 281.06
      }
    },
    {
      "hebrew": "וֶאֱמוּנָתְךָ סְבִיבוֹתֶֽיךָ.",
      "transliteration": "Ve’emunatecha sevivotecha.",
      "english": "And Your faith surrounds You.",
      "comments": "",
      "timing": {
        "start": 281.06,
        "end": 286.53
      }
    },
    {
      "hebrew": "סְבִיבוֹתֶֽיךָ אֵימָה מֵהוֹד מַמְלַכְתֶּֽךָ,",
      "transliteration": "Sevivotecha ema mehod mamlachtecha,",
      "english": "Surrounding You is dread, from the splendor of Your kingdom.",
      "comments": "",
      "timing": {
        "start": 286.53,
        "end": 303.33
      }
    },
    {
      "hebrew": "כִּסְאֲךָ לְדוֹר וָדוֹר וּלְעוֹלָם שִׁבְתֶּֽךָ,",
      "transliteration": "Kis’acha ledor vador ul‘olam shivtecha,",
      "english": "Your throne is for all generations, and Your enthronement is forever.",
      "comments": "",
      "timing": {
        "start": 303.33,
        "end": 316.43
      }
    },
    {
      "hebrew": "פָּעֳלֶֽיךָ הַכֹּל, וּבַכֹּל מֶמְשַׁלְתֶּֽךָ.",
      "transliteration": "Pa‘olecha hakkol, uvakkol memshaltecha.",
      "english": "All are Your creations, and Your dominion is over all—",
      "comments": "",
      "timing": {
        "start": 316.43,
        "end": 324.0
      }
    },
    {
      "hebrew": "אֵין קָדוֹשׁ כַּיוי כִּי אֵין בִּלְתֶּֽךָ.",
      "transliteration": "En ḳadosh kadonai ki en biltecha.",
      "english": "There is none holy like Adonai, for there is none but You. (1 Sam. 2:2)",
      "comments": "",
      "timing": {
        "start": 324.0,
        "end": 329.69
      }
    },
    {
      "hebrew": "אֵֽין־קָד֥וֹשׁ כַּיו֖י כִּ֣י אֵ֣ין בִּלְתֶּ֑ךָ וְאֵ֥ין צ֖וּר כֵּאלֹהֵֽינוּ׃",
      "transliteration": "En ḳadosh kadonai ki en biltecha ve’en tsur kelohenu.",
      "english": "There is none holy like Adonai, for there is none but You; and there is no rock like our God. (1 Sam. 2:2)",
      "comments": "",
      "timing": {
        "start": 329.69,
        "end": 337.85
      }
    },
    {
      "hebrew": "וְאַתָּ֥ה קָד֑וֹשׁ י֝וֹשֵׁ֗ב תְּהִלּ֥וֹת יִשְׂרָאֵֽל׃",
      "transliteration": "Ve’atta ḳadosh yoshev tehillot yisra’el.",
      "english": "And You are holy, enthroned on Israel’s praises. (Ps. 22:4)",
      "comments": "",
      "timing": {
        "start": 337.85,
        "end": 344.19
      }
    }
  ],
  "audio": "audio/a-atta-qadosh.mp3",
  "author_en": "Aaron ben Joseph"
}