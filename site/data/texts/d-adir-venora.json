{
  "id": "d-adir-venora",
  "title_en": "Addir Venora",
  "title_he": "אַדִּיר וְנוֹרָא",
  "category": "Liturgy",
  "subcategory": "Weekly Kedushot",
  "source": "kedushot.xlsx",
  "content": [
    {
      "hebrew": "אַדִּיר וְנוֹרָא כְּבוֹד אֵל עֶלְיוֹן,",
      "transliteration": "Addir venora kevod el ‘elyon,",
      "english": "Noble and awesome is the Glory of El ‘Elyon,",
      "comments": "",
      "timing": {
        "start": 0,
        "end": 28.04
      }
    },
    {
      "hebrew": "כְּמַרְאֵה הַקֶּֽשֶׁת נָגְהוֹ בְחִזָּיוֹן.",
      "transliteration": "Kemar’é haḳḳeshet noḡho veḥizzayon.",
      "english": "Like the appearance of the rainbow, with its glow in a vision.",
      "comments": "",
      "timing": {
        "start": 28.04,
        "end": 35.96
      }
    },
    {
      "hebrew": "הֲלֹא סְבִיבֹתָיו עָנָן גָּדוֹל,",
      "transliteration": "Halo sevivotav ‘anan gadol,",
      "english": "Is there not, surrounding it, a great cloud,",
      "comments": "",
      "timing": {
        "start": 35.96,
        "end": 49.74
      }
    },
    {
      "hebrew": "וְאֵשׁ מִתְלַקַּֽחַת וְנֹֽגַהּ לוֹ כְּמִגְדּוֹל.",
      "transliteration": "Ve’esh mitlaḳḳaḥat venoḡah lo kemiḡdol.",
      "english": "And fire flashing, and its glow like a tower?",
      "comments": "",
      "timing": {
        "start": 49.74,
        "end": 64.21
      }
    },
    {
      "hebrew": "רְאִיָּתוֹ כְּעֵין הַחַשְׁמַל, נָשׂוּא בַחַיּוֹת",
      "transliteration": "Re’iyyato ke‘en haḥasmal, nasu vaḥayyot",
      "english": "Its look is like the appearance of ḥashmal, borne by creatures—",
      "comments": "",
      "timing": {
        "start": 64.21,
        "end": 79.73
      }
    },
    {
      "hebrew": "אַרְבַּע; דְּמוּתָן דְּמוּת גְּוִיּוֹת.",
      "transliteration": "Arba‘; demutan demut geviyyot:",
      "english": "Four of them—whose image is that of bodies.",
      "comments": "",
      "timing": {
        "start": 79.73,
        "end": 91.15
      }
    },
    {
      "hebrew": "נוֹצָרוֹת דְּמוּת אָדָם בְּאַרְבָּעָה פָנִים;",
      "transliteration": "Notsarot demut adam be’arba‘a fanim;",
      "english": "They are formed in the image of a person, with four faces;",
      "comments": "",
      "timing": {
        "start": 91.15,
        "end": 106.31
      }
    },
    {
      "hebrew": "וְהַצּוּרָה אַחַת וְהַפָּנִים מְשֻׁנִּים.",
      "transliteration": "Vehats-tsura aḥat, vehappanim meshunnim.",
      "english": "The form is one, but the faces are different.",
      "comments": "",
      "timing": {
        "start": 106.31,
        "end": 118.4
      }
    },
    {
      "hebrew": "בְּאַרְבַּע כְּנָפַֽיִם בְּחִבּוּר, וּלְכַסּוֹת",
      "transliteration": "Be’arba‘ kenafayim beḥibbur, ulchassot",
      "english": "With four wings, touching, to cover",
      "comments": "",
      "timing": {
        "start": 118.4,
        "end": 132.37
      }
    },
    {
      "hebrew": "גְּוִיּוֹתֵיהֶן, וְלוֹ שֵׁשׁ נַעֲשׂוֹת.",
      "transliteration": "Geviyyotehen, velo shesh na‘asot.",
      "english": "Their bodies; and they have six.",
      "comments": "",
      "timing": {
        "start": 132.37,
        "end": 143.65
      }
    },
    {
      "hebrew": "נָטוּי רָקִֽיעַ בְּרָאשֵׁיהֶם כְּעֵין קֶֽרַח",
      "transliteration": "Natuy raḳiya‘ berashehem ke‘en ḳeraḥ",
      "english": "Stretched out over their heads is a firmament, like the appearance of awesome",
      "comments": "",
      "timing": {
        "start": 143.65,
        "end": 156.16
      }
    },
    {
      "hebrew": "נוֹרָא, כְּאוֹר יְקָרוֹת נִזְרָח.",
      "transliteration": "Nora, ke’or yeḳarot nizraḥ.",
      "english": "Ice, shining like the light of precious things.",
      "comments": "",
      "timing": {
        "start": 156.16,
        "end": 167.34
      }
    },
    {
      "hebrew": "יֹשֵׁב לְמַֽעַל לוֹ, בְּכִסֵּא מְעֻלֶּה,",
      "transliteration": "Yoshev lema‘al lo, bechissé me‘ullé,",
      "english": "Seated above it, in a throne above,",
      "comments": "",
      "timing": {
        "start": 167.34,
        "end": 182.18
      }
    },
    {
      "hebrew": "כְּמַרְאֵה אָדָם אֹדוֹת הַנִּדְבָּר לְהַפְלֵא.",
      "transliteration": "Kemar’é adam odot hannidbar lehaflé.",
      "english": "Is like the appearance of a human—[one must] marvel regarding what is said.",
      "comments": "",
      "timing": {
        "start": 182.18,
        "end": 194.46
      }
    },
    {
      "hebrew": "וְכָל־מַחֲזֶה וּמַרְאֶה עַל־פִּי הַנְּבִיאִים,",
      "transliteration": "Vechol maḥazé umar’é ‘al pi hannevi’im,",
      "english": "And every vision or apparition, according to the prophets,",
      "comments": "",
      "timing": {
        "start": 194.46,
        "end": 207.79
      }
    },
    {
      "hebrew": "וְכָל־סִפּוּר לְשֵֽׁמַע הָרֹאִים.",
      "transliteration": "Vechol sippur leshema‘ haro’im.",
      "english": "And every story, according to the report of those who saw it—",
      "comments": "",
      "timing": {
        "start": 207.79,
        "end": 219.66
      }
    },
    {
      "hebrew": "סוֹד עִנְיָנָם בְּסוֹד הַנֶּפֶשׁ נִפְלָא,",
      "transliteration": "Sod ‘inyanam besod hannefesh nifla,",
      "english": "Their mystical meaning is wondrous, partaking of the mystery of the soul.",
      "comments": "",
      "timing": {
        "start": 219.66,
        "end": 232.67
      }
    },
    {
      "hebrew": "כִּי לֹא יַעֲשֶׂה יוי אֱלֹהִים דָּבָר כִּי אִם גָּלָה.",
      "transliteration": "Ki lo ya‘asé adonai Elohim davar ki im gala.",
      "english": "For Adonai, God, does not do anything without revealing [it].",
      "comments": "",
      "timing": {
        "start": 232.67,
        "end": 247.1
      }
    },
    {
      "hebrew": "פְּלִיאוּת דְּבָרוֹ עַל־פִּי נְבִיאָיו עָרוּךְ.",
      "transliteration": "Peli’ut devaro, ‘al pi nevi’av ‘aruch:",
      "english": "The wondrousness of His word is formulated by His prophets.",
      "comments": "",
      "timing": {
        "start": 247.1,
        "end": 254.39
      }
    },
    {
      "hebrew": "יִתְרוֹמַם וְיִתְפָּאַר מְבֹרָךְ וּבָרוּךְ.",
      "transliteration": "Yitromam veyitpa’ar, mevorach uvaruch.",
      "english": "Elevated and glorified be the One who is declared blessed, and is blessed.",
      "comments": "",
      "timing": {
        "start": 254.39,
        "end": 260.67
      }
    },
    {
      "hebrew": "וּבָר֤וּךְ ׀ שֵׁ֥ם כְּבוֹד֗וֹ לְע֫וֹלָ֥ם וְיִמָּלֵ֣א כְ֭בוֹד֖וֹ אֶת־כֹּ֥ל הָאָ֗רֶץ אָ֘מֵ֥ן ׀ וְאָמֵֽן׃ (תהלים עב:יט)",
      "transliteration": "Uvaruch shem kevodo le‘olam veyimmalé chevodo et kol ha’arets amen, ve’amen:",
      "english": "And blessed be His glorious name forever, and may his Glory fill the whole world. Amen and Amen! (Ps. 72:19)",
      "comments": "",
      "timing": {
        "start": 260.67,
        "end": 272.4
      }
    },
    {
      "hebrew": "בָּר֥וּךְ כְּבוֹד־יו֖י מִמְּקוֹמֽוֹ׃ (יחזקאל ג:יב)",
      "transliteration": "Baruch kevod adonai mimmeḳomo:",
      "english": "Blessed be Adonai’s Glory from His place. (Ezek. 3:12)",
      "comments": "",
      "timing": {
        "start": 272.4,
        "end": 277.74
      }
    }
  ],
  "audio": "audio/d-adir-venora.mp3",
  "author_en": "Aaron ben Joseph"
}